.anakin-logo-wrap {
  min-height: 2.5rem;
}

.anakin-logo {
  height: 2.5rem;
  aspect-ratio: 6/5;
}

@media (width < 64rem) {
  .anakin-navbar {
    width: 100%;
    background-color: transparent;
    justify-content: space-between;
  }
}
@media (min-width: 64rem) {
  .anakin-navbar .anakin-logo {
    display: none;
  }
}

.anakin-aside .anakin-logo-wrap {
  display: none;
}
@media (min-width: 48rem) {
  .anakin-aside .anakin-logo-wrap {
    display: block;
    padding-inline: 1rem;
  }
}
@media (min-width: 48rem) {
  .anakin-aside .aside-main {
    padding-top: calc(2rem + 1px);
  }
}
