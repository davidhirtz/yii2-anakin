.anakin-logo {
  min-height: 2.5rem;
  place-content: center;
}

.anakin-logo-img {
  height: 1rem;
  aspect-ratio: 888/137;
}

@media (width < 64rem) {
  .anakin-navbar {
    width: 100%;
    background-color: transparent;
    justify-content: space-between;
  }
}
@media (min-width: 64rem) {
  .anakin-navbar .anakin-logo {
    display: none;
  }
}

.anakin-aside .anakin-logo {
  display: none;
}
@media (min-width: 48rem) {
  .anakin-aside .anakin-logo {
    display: block;
    min-width: 0;
    opacity: var(--aside-open, 1);
    overflow: hidden;
    padding-inline: 2rem;
    transition: opacity 0.2s;
  }
}
@media (min-width: 48rem) {
  .anakin-aside .aside-main {
    padding-top: calc(2rem + 1px);
  }
}
