.anakin-logo {
  min-height: 2.5rem;
  place-content: center;
}

.anakin-logo-img {
  height: 1rem;
  aspect-ratio: 888/137;
}

@media (width < 64rem) {
  .anakin-navbar {
    width: 100%;
    background-color: transparent;
    justify-content: space-between;
  }
}
@media (min-width: 64rem) {
  .anakin-navbar .anakin-logo {
    display: none;
  }
}

.anakin-aside .aside-header {
  padding-inline: 2rem 1rem;
}
.anakin-aside .anakin-logo {
  min-width: 0;
  opacity: var(--aside-open, 1);
  overflow: hidden;
  transition: opacity 0.2s;
}
.anakin-aside .aside-main {
  padding-top: 1rem;
}
